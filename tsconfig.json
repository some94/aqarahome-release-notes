{
  // 서버(GAS) 코드용. 웹 뷰어는 src/web/tsconfig.json, 테스트는 test/tsconfig.json
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["google-apps-script"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/server/**/*.ts", "src/parser/**/*.ts", "src/shared/**/*.ts"]
}
